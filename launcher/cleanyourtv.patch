+    /**
+     * The next occasion within 100 days, by the same Hijri date as the rest of Home (with the control center's
+     * offset): «اليوم يوم عرفة», «بكرا عيد الأضحى», «رمضان بعد 89 يوم». Worked out once a day.
+     */
+    static String nextEvent() {
+        int today = Calendar.getInstance().get(Calendar.DAY_OF_YEAR);
+        if (today == eventDay) return eventText;
+        String found = "";
+        for (int k = 0; k <= 100 && found.isEmpty(); k++) {
+            IslamicCalendar h = hijriCal(k);
+            int m = h.get(IslamicCalendar.MONTH), d = h.get(IslamicCalendar.DAY_OF_MONTH);
+            for (int e = 0; e < EVENT_DAYS.length; e++) {
+                if (EVENT_DAYS[e][0] != m || EVENT_DAYS[e][1] != d) continue;
+                if (e == 0 && k == 0) break;   // the first of Ramadan: Home already greets it
