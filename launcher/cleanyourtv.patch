+        boolean hindi = digits() == 0;
+        android.text.SpannableStringBuilder b = null;
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            char to = 0;
+            if (hindi && ch >= '0' && ch <= '9') to = (char) ('٠' + (ch - '0'));
+            else if (!hindi && ch >= '٠' && ch <= '٩') to = (char) ('0' + (ch - '٠'));
+            if (to == 0) continue;
+            if (b == null) b = s instanceof android.text.SpannableStringBuilder
+                    ? (android.text.SpannableStringBuilder) s : new android.text.SpannableStringBuilder(s);
