@@ -0,0 +1,86 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Kids mode, after the day's screen time: a calm full screen instead of Home. OK asks the parents' PIN for thirty
+ * more minutes; Back keeps the screen (Home would only bring it back).
+ */
+public class NoorLockActivity extends Activity {
+    private boolean unlocked;
+
+    @Override
+    protected void onCreate(Bundle b) {
+        super.onCreate(b);
+        NoorKids.stop(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER);
+        root.setBackground(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                new int[]{0xFF0B1430, 0xFF140B26, 0xFF05060E}));
+        root.addView(text("🌙", 64, 0xFFF6E7C1));
+        root.addView(text("خلص وقت الشاشة لليوم", 40, 0xFFF4EEDF));
+        root.addView(text("نرجع نتفرّج بكرة إن شاء الله 🤍", 24, 0xFFE3BE6E));
+        TextView parents = text("للأهل: OK ثم الرقم السري لزيادة نص ساعة", 16, 0x99F4EEDF);
+        parents.setPadding(0, 60, 0, 0);
+        root.addView(parents);
+        setContentView(root);
+    }
+
+    private TextView text(String s, float sp, int color) {
+        TextView t = new TextView(this);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setGravity(Gravity.CENTER);
+        t.setPadding(0, 12, 0, 12);
+        return t;
+    }
+
+    @Override
+    public boolean dispatchKeyEvent(KeyEvent e) {
+        int code = e.getKeyCode();
+        // the volume stays the remote's; every other key stays here (an app button would leave the rest screen)
+        if (code == KeyEvent.KEYCODE_VOLUME_UP || code == KeyEvent.KEYCODE_VOLUME_DOWN || code == KeyEvent.KEYCODE_VOLUME_MUTE) {
+            return super.dispatchKeyEvent(e);
+        }
+        if (e.getAction() == KeyEvent.ACTION_DOWN && e.getRepeatCount() == 0
+                && (code == KeyEvent.KEYCODE_DPAD_CENTER || code == KeyEvent.KEYCODE_ENTER)) {
+            NoorPrefs prefs = new NoorPrefs(this);
+            NoorPin.ask(this, "الرقم السري للأهل", prefs.kidsPin(), (ok, pin) -> {
+                if (ok) {
+                    prefs.extendKids(30 * 60_000L);
+                    unlocked = true;
+                    // back to the app that was open: the half hour counts from now (Home stops it if it is Home)
+                    NoorKids.leaveHome(this);
+                    finish();
+                }
+            });
+        }
+        return true;
+    }
+
+    @Override
+    protected void onStop() {
+        super.onStop();
+        // pushed away (an app button, a source key) while the time is still up: back on top
+        if (unlocked || isFinishing() || !new NoorPrefs(this).kidsTimeUp()) return;
+        if (!getSystemService(PowerManager.class).isInteractive()) return;
+        new Handler(Looper.getMainLooper()).postDelayed(() -> {
+            if (!unlocked && new NoorPrefs(this).kidsTimeUp()) {
+                startActivity(new android.content.Intent(this, NoorLockActivity.class)
+                        .addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK));
+            }
+        }, 400);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/NoorPin.java b/launcher/app/src/main/java/com/gathin/tvhome/NoorPin.java
new file mode 100644
index 0000000..1d67049
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/NoorPin.java
@@ -0,0 +1,166 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * A four-digit PIN asked with the remote: the number keys type a digit, or Up/Down change the digit in the gold box
+ * and Right/Left move between boxes; OK checks it. The parents' key to the control center and to more screen time
+ * while kids mode is on.
+ */
+final class NoorPin {
+    interface Result {
+        void done(boolean ok, String pin);
+    }
+
+    private NoorPin() {
+    }
+
+    private static int fails;
+    private static long lockedUntil;
+
+    /** Asks for a PIN; when check is non-null the result is whether it matches, otherwise any four digits pass. */
+    static void ask(Activity a, String title, String check, Result result) {
+        Dialog d = new Dialog(a);
+        d.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        float density = a.getResources().getDisplayMetrics().density;
+        LinearLayout box = new LinearLayout(a);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setGravity(Gravity.CENTER);
+        box.setPadding((int) (36 * density), (int) (24 * density), (int) (36 * density), (int) (24 * density));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0xF0101830);
+        bg.setCornerRadius(20 * density);
+        bg.setStroke((int) (2 * density), 0xFFE3BE6E);
+        box.setBackground(bg);
+
+        TextView t = new TextView(a);
+        t.setText(title);
+        t.setTextColor(0xFFF4EEDF);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20);
+        t.setGravity(Gravity.CENTER);
+        box.addView(t);
+
+        LinearLayout row = new LinearLayout(a);
+        row.setGravity(Gravity.CENTER);
+        row.setPadding(0, (int) (18 * density), 0, (int) (10 * density));
+        int[] digits = new int[4];
+        boolean[] set = new boolean[4];
+        int[] at = {0};
+        TextView[] cells = new TextView[4];
+        for (int i = 0; i < 4; i++) {
+            TextView c = new TextView(a);
+            c.setTextSize(TypedValue.COMPLEX_UNIT_SP, 32);
+            c.setTypeface(Typeface.DEFAULT_BOLD);
+            c.setTextColor(0xFFFFFFFF);
+            c.setGravity(Gravity.CENTER);
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams((int) (56 * density), (int) (68 * density));
+            lp.leftMargin = lp.rightMargin = (int) (6 * density);
+            row.addView(c, lp);
+            cells[i] = c;
+        }
+        box.addView(row);
+        TextView help = new TextView(a);
+        help.setText("أرقام الريموت، أو فوق وتحت لتغيير الرقم · OK للتأكيد");
+        help.setTextColor(0x99F4EEDF);
+        help.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        help.setGravity(Gravity.CENTER);
+        box.addView(help);
+
+        Runnable draw = () -> {
+            for (int i = 0; i < 4; i++) {
+                cells[i].setText(set[i] ? (i == at[0] ? String.valueOf(digits[i]) : "●") : (i == at[0] ? String.valueOf(digits[i]) : "–"));
+                GradientDrawable g = new GradientDrawable();
+                g.setCornerRadius(12 * density);
+                g.setColor(i == at[0] ? 0x40E3BE6E : 0x22FFFFFF);
+                g.setStroke((int) ((i == at[0] ? 2 : 1) * density), i == at[0] ? 0xFFE3BE6E : 0x44FFFFFF);
+                cells[i].setBackground(g);
+            }
+        };
+        draw.run();
+
+        boolean[] finished = {false};
+        Runnable submit = () -> {
+            StringBuilder s = new StringBuilder();
+            for (int x : digits) s.append(x);
+            String pin = s.toString();
+            boolean ok = check == null || check.equals(pin);
+            if (!ok && ++fails >= 3) {
+                fails = 0;
+                lockedUntil = System.currentTimeMillis() + 60_000L;
+            }
+            if (ok) fails = 0;
+            if (!ok) {
+                t.setText(System.currentTimeMillis() < lockedUntil ? "3 مرات غلط · استنى دقيقة وجرّب" : "الرقم غلط · جرّب مرة ثانية");
+                for (int i = 0; i < 4; i++) {
+                    digits[i] = 0;
+                    set[i] = false;
+                }
+                at[0] = 0;
+                draw.run();
+                return;
+            }
+            finished[0] = true;
+            d.dismiss();
+            result.done(true, pin);
+        };
+        d.setOnKeyListener((dialog, code, e) -> {
+            if (e.getAction() != KeyEvent.ACTION_DOWN) return false;
+            if (check != null && System.currentTimeMillis() < lockedUntil && code != KeyEvent.KEYCODE_BACK) {
+                t.setText("استنى " + ((lockedUntil - System.currentTimeMillis()) / 1000 + 1) + " ثانية وجرّب");
+                return true;
+            }
+            if (code >= KeyEvent.KEYCODE_0 && code <= KeyEvent.KEYCODE_9) {
+                digits[at[0]] = code - KeyEvent.KEYCODE_0;
+                set[at[0]] = true;
+                if (at[0] < 3) at[0]++;
+                else submit.run();
+                draw.run();
+                return true;
+            }
+            switch (code) {
+                case KeyEvent.KEYCODE_DPAD_UP:
+                case KeyEvent.KEYCODE_DPAD_DOWN:
+                    digits[at[0]] = (digits[at[0]] + (code == KeyEvent.KEYCODE_DPAD_UP ? 1 : 9)) % 10;
+                    set[at[0]] = true;
+                    draw.run();
+                    return true;
+                case KeyEvent.KEYCODE_DPAD_RIGHT:
+                    at[0] = Math.min(3, at[0] + 1);
+                    draw.run();
+                    return true;
+                case KeyEvent.KEYCODE_DPAD_LEFT:
+                    at[0] = Math.max(0, at[0] - 1);
+                    draw.run();
+                    return true;
+                case KeyEvent.KEYCODE_DPAD_CENTER:
+                case KeyEvent.KEYCODE_ENTER:
+                    set[at[0]] = true;
+                    if (at[0] < 3) {
+                        at[0]++;
+                        draw.run();
+                    } else {
+                        submit.run();
+                    }
+                    return true;
+            }
+            return false;
+        });
+        d.setOnDismissListener(x -> {
+            if (!finished[0]) result.done(false, null);
+        });
+        d.setContentView(box, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+        if (d.getWindow() != null) d.getWindow().setBackgroundDrawableResource(android.R.color.transparent);
+        d.show();
+    }
+}
