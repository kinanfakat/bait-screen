+        IslamicCalendar h = new IslamicCalendar();
+        h.setCalculationType(IslamicCalendar.CalculationType.ISLAMIC_UMALQURA);
+        h.setTimeInMillis(d.getTimeInMillis());
+        return h;
+    }   // w4: times asked in the TV's time zone
