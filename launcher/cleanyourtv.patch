+    /** The year's occasions by Hijri month (0-based, as IslamicCalendar) and day. */
+    private static final int[][] EVENT_DAYS = {{8, 1}, {9, 1}, {11, 9}, {11, 10}, {0, 1}, {0, 10}};
+    private static final String[] EVENT_NAMES = {"🌙 رمضان", "🎉 عيد الفطر", "🤲 يوم عرفة", "🐑 عيد الأضحى",
