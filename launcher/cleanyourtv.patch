@@ -0,0 +1,209 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.List;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * إمساكية الأسبوع: the prayer times of today and the six days after, for the control center's city and method, in
+ * the TV's own time zone. From the Aladhan monthly calendar, kept on the TV per month.
+ */
+public class NoorWeekActivity extends Activity {
+    private static final int GOLD = 0xFFFFD27A;
+    private static final String[] KEYS = {"Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"};
+    private static final String[] HEAD = {"الفجر", "الشروق", "الظهر", "العصر", "المغرب", "العشاء"};
+    private static final String[] DAYS = {"الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"};
+
+    private LinearLayout table;
+    private TextView status;
+    private NoorPrefs prefs;
+
+    @Override
+    protected void onCreate(Bundle b) {
+        super.onCreate(b);
+        prefs = new NoorPrefs(this);
+        float d = getResources().getDisplayMetrics().density;
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER_HORIZONTAL);
+        root.setPadding((int) (40 * d), (int) (28 * d), (int) (40 * d), (int) (20 * d));
+        root.setBackground(new GradientDrawable(GradientDrawable.Orientation.TL_BR,
+                new int[]{0xFF0F1A2E, 0xFF14102A, 0xFF060A14}));
+
+        TextView title = text("✦  مواقيت الصلاة للأسبوع · " + prefs.cityName() + "  ✦", 28, GOLD, true);
+        root.addView(title);
+        status = text("جاري التحميل…", 15, 0x99FFFFFF, false);
+        status.setPadding(0, (int) (6 * d), 0, (int) (16 * d));
+        root.addView(status);
+        table = new LinearLayout(this);
+        table.setOrientation(LinearLayout.VERTICAL);
+        root.addView(table, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+        setContentView(root);
+
+        Handler main = new Handler(Looper.getMainLooper());
+        new Thread(() -> {
+            List<JSONObject> days = week();
+            main.post(() -> show(days));
+        }, "week").start();
+    }
+
+    /** Today and the next six days, crossing into next month when needed. */
+    private List<JSONObject> week() {
+        List<JSONObject> out = new ArrayList<>();
+        Calendar c = Calendar.getInstance();
+        try {
+            for (int month = 0; month < 2 && out.size() < 7; month++) {
+                Calendar m = (Calendar) c.clone();
+                m.add(Calendar.MONTH, month);
+                JSONArray data = month(m.get(Calendar.YEAR), m.get(Calendar.MONTH) + 1);
+                if (data == null) break;
+                for (int i = 0; i < data.length() && out.size() < 7; i++) {
+                    JSONObject day = data.getJSONObject(i);
+                    int dom = Integer.parseInt(day.getJSONObject("date").getJSONObject("gregorian").getString("day"));
+                    if (month == 0 && dom < c.get(Calendar.DAY_OF_MONTH)) continue;
+                    out.add(day);
+                }
+            }
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    private JSONArray month(int year, int month) {
+        String place = prefs.lat() + "," + prefs.lon() + "," + prefs.method() + "," + TimeZone.getDefault().getID();
+        File cache = new File(getCacheDir(), "week_" + year + "_" + month + "_" + Math.abs(place.hashCode()) + ".json");
+        try {
+            if (cache.exists()) return new JSONArray(new String(Files.readAllBytes(cache.toPath()), StandardCharsets.UTF_8));
+        } catch (Exception ignored) {
+        }
+        try {
+            String url = "https://api.aladhan.com/v1/calendar/" + year + "/" + month + "?latitude=" + prefs.lat()
+                    + "&longitude=" + prefs.lon() + "&method=" + prefs.method()
+                    + "&timezonestring=" + URLEncoder.encode(TimeZone.getDefault().getID(), "UTF-8");
+            HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+            c.setConnectTimeout(10000);
+            c.setReadTimeout(20000);
+            try (InputStream in = c.getInputStream()) {
+                ByteArrayOutputStream b = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) > 0) b.write(buf, 0, n);
+                JSONArray data = new JSONObject(b.toString("UTF-8")).getJSONArray("data");
+                try (FileOutputStream o = new FileOutputStream(cache)) {
+                    o.write(data.toString().getBytes(StandardCharsets.UTF_8));
+                }
+                return data;
+            } finally {
+                c.disconnect();
+            }
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private void show(List<JSONObject> days) {
+        if (days.isEmpty()) {
+            status.setText("ما قدرت أجيب المواقيت · تأكد من النت وارجع افتحها");
+            return;
+        }
+        status.setText("حسب " + methodName() + " · بتوقيت التلفزيون");
+        // the launcher lays out left to right: the columns go Isha … Fajr, then the date and the day on the right
+        table.addView(row(true, false, "العشاء", "المغرب", "العصر", "الظهر", "الشروق", "الفجر", "التاريخ", "اليوم"));
+        for (int i = 0; i < days.size(); i++) {
+            try {
+                JSONObject day = days.get(i);
+                JSONObject t = day.getJSONObject("timings");
+                JSONObject date = day.getJSONObject("date");
+                JSONObject hijri = date.getJSONObject("hijri");
+                String[] v = new String[KEYS.length];
+                for (int k = 0; k < KEYS.length; k++) v[k] = clock12(t.getString(KEYS[k]));
+                int weekday = dayOfWeek(date.getJSONObject("gregorian").getString("date"));
+                String hd = hijri.getString("day") + " " + hijri.getJSONObject("month").getString("ar");
+                table.addView(row(false, i == 0, v[5], v[4], v[3], v[2], v[1], v[0], hd,
+                        i == 0 ? "اليوم" : DAYS[weekday]));
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+    private LinearLayout row(boolean head, boolean today, String... cells) {
+        float d = getResources().getDisplayMetrics().density;
+        LinearLayout r = new LinearLayout(this);
+        r.setGravity(Gravity.CENTER_VERTICAL);
+        r.setPadding((int) (10 * d), (int) (9 * d), (int) (10 * d), (int) (9 * d));
+        GradientDrawable g = new GradientDrawable();
+        g.setCornerRadius(12 * d);
+        g.setColor(today ? 0x33FFD27A : head ? 0x00000000 : 0x14FFFFFF);
+        if (today) g.setStroke((int) (1.5f * d), GOLD);
+        r.setBackground(g);
+        for (int i = 0; i < cells.length; i++) {
+            boolean wide = i >= cells.length - 2;
+            TextView t = text(String.valueOf(prefs.localize(cells[i])), head ? 15 : 19,
+                    head ? GOLD : today ? GOLD : 0xF2FFFFFF, today || head);
+            r.addView(t, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, wide ? 1.4f : 1f));
+        }
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = (int) (5 * d);
+        r.setLayoutParams(lp);
+        return r;
+    }
+
+    private String methodName() {
+        for (int i = 0; i < NoorPrefs.METHODS.length; i++) if (NoorPrefs.METHODS[i] == prefs.method()) return NoorPrefs.METHOD_NAMES[i];
+        return "";
+    }
+
+    /** "05:37 (+03)" → "5:37" */
+    private static String clock12(String hhmm) {
+        String[] p = hhmm.substring(0, 5).split(":");
+        int h = Integer.parseInt(p[0]) % 12;
+        if (h == 0) h = 12;
+        return h + ":" + p[1];
+    }
+
+    /** "11-11-2026" → 0 Sunday … 6 Saturday */
+    private static int dayOfWeek(String ddmmyyyy) {
+        String[] p = ddmmyyyy.split("-");
+        Calendar c = Calendar.getInstance(Locale.US);
+        c.set(Integer.parseInt(p[2]), Integer.parseInt(p[1]) - 1, Integer.parseInt(p[0]));
+        return c.get(Calendar.DAY_OF_WEEK) - 1;
+    }
+
+    private TextView text(String s, float sp, int color, boolean bold) {
+        TextView t = new TextView(this);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setGravity(Gravity.CENTER);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        return t;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/PhonePad.java b/launcher/app/src/main/java/com/gathin/tvhome/PhonePad.java
new file mode 100644
index 0000000..cd4a6b5
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/PhonePad.java
@@ -0,0 +1,409 @@
+package com.gathin.tvhome;
+
+import android.accessibilityservice.AccessibilityService;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Point;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+/**
+ * The phone as a keyboard and a mouse (the phone page of Noor): its server sends PAD broadcasts and this turns them
+ * into a pointer drawn over the screen, clicks and scrolls on what it stands on, text in the focused field, focus moves, Back
+ * and Home. Only senders that hold PERMISSION are heard.
+ *
+ * "m dx dy" move · "c" click · "r" long press (right button) · "s dy" scroll · "k up|down|left|right|ok|back|home|enter" · "t text" the text of the field
+ * "a fx fy" click at that place (fractions of the screen) · "l fx fy" long press there · "p" a picture of the screen, sent to Noor
+ */
+final class PhonePad {
+    static final String ACTION = "com.gathin.tvhome.PAD";
+    static final String PERMISSION = "com.gathin.tvhome.permission.PAD";
+    private static final int SIZE = 44;
+
+    private final AccessibilityService service;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final Point screen = new Point();
+    private BroadcastReceiver receiver;
+    private View pointer;
+    private float x, y;
+    private final Runnable hide = this::hidePointer;
+
+    PhonePad(AccessibilityService service) {
+        this.service = service;
+    }
+
+    void start() {
+        if (receiver != null) return;
+        receiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                String c = intent.getStringExtra("c");
+                if (c == null || c.isEmpty()) return;
+                try {
+                    handle(c);
+                } catch (RuntimeException e) {
+                    android.util.Log.w("PhonePad", c, e);
+                }
+            }
+        };
+        // Android 14 refuses a receiver for another app's broadcast without saying it is exported
+        if (android.os.Build.VERSION.SDK_INT >= 33) {
+            service.registerReceiver(receiver, new IntentFilter(ACTION), PERMISSION, main, Context.RECEIVER_EXPORTED);
+        } else {
+            service.registerReceiver(receiver, new IntentFilter(ACTION), PERMISSION, main);
+        }
+    }
+
+    void stop() {
+        if (receiver != null) {
+            try {
+                service.unregisterReceiver(receiver);
+            } catch (RuntimeException ignored) {
+            }
+            receiver = null;
+        }
+        main.removeCallbacks(hide);
+        hidePointer();
+    }
+
+    private void handle(String c) {
+        String arg = c.length() > 2 ? c.substring(2) : "";
+        switch (c.charAt(0)) {
+            case 'm': {
+                String[] d = arg.trim().split(" ");
+                if (d.length == 2) move(Float.parseFloat(d[0]), Float.parseFloat(d[1]));
+                break;
+            }
+            case 'c':
+                if (pointer == null) move(0, 0);
+                else tap();
+                break;
+            case 'r':
+                if (pointer == null) move(0, 0);
+                else longTap();
+                break;
+            case 's':
+                swipe(Float.parseFloat(arg.trim()));
+                break;
+            case 'k':
+                key(arg.trim());
+                break;
+            case 't':
+                text(arg);
+                break;
+            case 'a':
+            case 'l': {
+                // the phone's view of the screen: a touch on the picture lands on that place on the TV
+                String[] d = arg.trim().split(" ");
+                if (d.length != 2) break;
+                service.getSystemService(WindowManager.class).getDefaultDisplay().getRealSize(screen);
+                float fx = Math.max(0f, Math.min(1f, Float.parseFloat(d[0]))), fy = Math.max(0f, Math.min(1f, Float.parseFloat(d[1])));
+                if (pointer == null) move(0, 0);
+                move(fx * screen.x - x, fy * screen.y - y);
+                if (c.charAt(0) == 'a') tap();
+                else longTap();
+                break;
+            }
+            case 'v': {
+                // a swipe on the phone's picture of the screen: "fx fy d", d < 0 when the finger went up (the next video)
+                String[] d = arg.trim().split(" ");
+                if (d.length != 3) break;
+                service.getSystemService(WindowManager.class).getDefaultDisplay().getRealSize(screen);
+                float fx = Math.max(0f, Math.min(1f, Float.parseFloat(d[0]))), fy = Math.max(0f, Math.min(1f, Float.parseFloat(d[1])));
+                if (pointer == null) move(0, 0);
+                move(fx * screen.x - x, fy * screen.y - y);
+                swipe(Float.parseFloat(d[2]));
+                break;
+            }
+            case 'A': {
+                // the pointer where Noor keeps it (pixels): Noor's clicks are real touches at that very point
+                String[] d = arg.trim().split(" ");
+                if (d.length != 2) break;
+                if (pointer == null) move(0, 0);
+                move(Float.parseFloat(d[0]) - x, Float.parseFloat(d[1]) - y);
+                break;
+            }
+            case 'p':
+                picture();
+                break;
+            case 'e':
+                editing();
+                break;
+            case 'w':
+                // out of the screensaver: the adhan's screen is coming up
+                ClockDream.wake();
+                break;
+            case 'z':
+                // the TV back to standby after an adhan that switched it on
+                if (android.os.Build.VERSION.SDK_INT >= 28) {
+                    service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_LOCK_SCREEN);
+                }
+                break;
+            default:
+        }
+    }
+
+    /**
+     * Whether a text field has the focus on the screen now (a search box was touched), told to Noor with its text, so
+     * the phone shows its keyboard at once, as a phone app would.
+     */
+    private void editing() {
+        boolean on = false;
+        CharSequence text = "";
+        try {
+            AccessibilityNodeInfo root = service.getRootInActiveWindow();
+            AccessibilityNodeInfo f = root == null ? null : root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
+            if (f != null && f.isEditable()) {
+                on = true;
+                text = f.isShowingHintText() || f.getText() == null ? "" : f.getText();
+            }
+        } catch (RuntimeException ignored) {
+        }
+        service.sendBroadcast(new Intent("app.noortv.EDIT").setPackage("app.noortv.kahf").putExtra("on", on)
+                .putExtra("text", text.toString()).addFlags(Intent.FLAG_RECEIVER_FOREGROUND), PERMISSION);
+    }
+
+    private long lastPicture;
+
+    /**
+     * A picture of the screen for the phone page (Android 11's accessibility screenshot: no prompt on the TV), made
+     * small and sent to Noor, which asked for it. At most one a second: Android 11 refuses them sooner.
+     */
+    private void picture() {
+        if (android.os.Build.VERSION.SDK_INT < 30) return;
+        long now = android.os.SystemClock.uptimeMillis();
+        if (now - lastPicture < 1000) return;
+        lastPicture = now;
+        try {
+            service.takeScreenshot(android.view.Display.DEFAULT_DISPLAY, service.getMainExecutor(),
+                    new AccessibilityService.TakeScreenshotCallback() {
+                        @Override
+                        public void onSuccess(AccessibilityService.ScreenshotResult r) {
+                            new Thread(() -> send(r), "pad-picture").start();
+                        }
+
+                        @Override
+                        public void onFailure(int code) {
+                        }
+                    });
+        } catch (RuntimeException ignored) {
+        }
+    }
+
+    private void send(AccessibilityService.ScreenshotResult r) {
+        try {
+            android.hardware.HardwareBuffer hb = r.getHardwareBuffer();
+            android.graphics.Bitmap hw = android.graphics.Bitmap.wrapHardwareBuffer(hb, r.getColorSpace());
+            hb.close();
+            if (hw == null) return;
+            android.graphics.Bitmap sw = hw.copy(android.graphics.Bitmap.Config.ARGB_8888, false);
+            hw.recycle();
+            int w = 960, h = Math.max(1, sw.getHeight() * w / Math.max(1, sw.getWidth()));
+            android.graphics.Bitmap small = android.graphics.Bitmap.createScaledBitmap(sw, w, h, true);
+            sw.recycle();
+            java.io.ByteArrayOutputStream o = new java.io.ByteArrayOutputStream();
+            small.compress(android.graphics.Bitmap.CompressFormat.JPEG, 62, o);
+            small.recycle();
+            service.sendBroadcast(new Intent("app.noortv.SCREEN_FRAME").setPackage("app.noortv.kahf")
+                    .putExtra("jpg", o.toByteArray()).addFlags(Intent.FLAG_RECEIVER_FOREGROUND), PERMISSION);
+        } catch (RuntimeException ignored) {
+        }
+    }
+
+    private void move(float dx, float dy) {
+        WindowManager wm = service.getSystemService(WindowManager.class);
+        wm.getDefaultDisplay().getRealSize(screen);
+        if (pointer == null) {
+            x = screen.x / 2f;
+            y = screen.y / 2f;
+            pointer = new Arrow(service);
+            try {
+                wm.addView(pointer, params());
+            } catch (RuntimeException e) {
+                pointer = null;
+                return;
+            }
+        }
+        x = Math.max(0, Math.min(screen.x - 1, x + dx));
+        y = Math.max(0, Math.min(screen.y - 1, y + dy));
+        try {
+            wm.updateViewLayout(pointer, params());
+        } catch (RuntimeException ignored) {
+        }
+        main.removeCallbacks(hide);
+        main.postDelayed(hide, 60_000);
+    }
+
+    private WindowManager.LayoutParams params() {
+        WindowManager.LayoutParams lp = new WindowManager.LayoutParams(SIZE, SIZE,
+                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                PixelFormat.TRANSLUCENT);
+        lp.gravity = Gravity.TOP | Gravity.LEFT;
+        lp.x = (int) x;
+        lp.y = (int) y;
+        return lp;
+    }
+
+    private void hidePointer() {
+        if (pointer == null) return;
+        try {
+            service.getSystemService(WindowManager.class).removeView(pointer);
+        } catch (RuntimeException ignored) {
+        }
+        pointer = null;
+    }
+
+    /**
+     * A click on what the pointer stands on. Not a touch gesture: a TV has no touch screen, so the system cancels
+     * dispatchGesture at once; the smallest clickable thing under the pointer is clicked by its node instead.
+     */
+    private void tap() {
+        AccessibilityNodeInfo n = under(service.getRootInActiveWindow(), false, 0);
+        if (n != null) {
+            n.performAction(AccessibilityNodeInfo.ACTION_FOCUS);
+            n.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+        }
+        move(0, 0);
+    }
+
+    /** The right button: a long press on what the pointer stands on (its menu, where it has one). */
+    private void longTap() {
+        AccessibilityNodeInfo n = under(service.getRootInActiveWindow(), false, 0);
+        // the thing itself, or the first of its parents that takes a long press
+        for (int i = 0; n != null && i < 6; i++, n = n.getParent()) {
+            if (n.isLongClickable() && n.performAction(AccessibilityNodeInfo.ACTION_LONG_CLICK)) break;
+        }
+        move(0, 0);
+    }
+
+    /** One step of the list under the pointer; dy < 0: the finger went up the pad, the list goes on. */
+    private void swipe(float dy) {
+        if (pointer == null) move(0, 0);
+        AccessibilityNodeInfo n = under(service.getRootInActiveWindow(), true, 0);
+        if (n != null) {
+            n.performAction(dy < 0 ? AccessibilityNodeInfo.ACTION_SCROLL_FORWARD : AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD);
+        }
+        move(0, 0);
+    }
+
+    /** The smallest clickable (or scrollable) node on screen that holds the pointer. */
+    private AccessibilityNodeInfo under(AccessibilityNodeInfo n, boolean scrollable, int depth) {
+        if (n == null || depth > 60 || !n.isVisibleToUser()) return null;
+        android.graphics.Rect r = new android.graphics.Rect();
+        n.getBoundsInScreen(r);
+        if (!r.contains((int) x, (int) y)) return null;
+        AccessibilityNodeInfo best = null;
+        long bestArea = Long.MAX_VALUE;
+        for (int i = 0; i < n.getChildCount(); i++) {
+            AccessibilityNodeInfo c = under(n.getChild(i), scrollable, depth + 1);
+            if (c == null) continue;
+            c.getBoundsInScreen(r);
+            long area = (long) r.width() * r.height();
+            if (area < bestArea) {
+                best = c;
+                bestArea = area;
+            }
+        }
+        if (best != null) return best;
+        return (scrollable ? n.isScrollable() : n.isClickable() || n.isEditable()) ? n : null;
+    }
+
+    private void key(String k) {
+        if (k.equals("back")) {
+            service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_BACK);
+            return;
+        }
+        if (k.equals("home")) {
+            service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_HOME);
+            return;
+        }
+        AccessibilityNodeInfo root = service.getRootInActiveWindow();
+        if (root == null) return;
+        AccessibilityNodeInfo f = root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
+        if (f == null) return;
+        int dir;
+        switch (k) {
+            case "ok":
+                f.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+                return;
+            case "enter":
+                f.performAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_IME_ENTER.getId());
+                return;
+            case "up": dir = View.FOCUS_UP; break;
+            case "down": dir = View.FOCUS_DOWN; break;
+            case "left": dir = View.FOCUS_LEFT; break;
+            case "right": dir = View.FOCUS_RIGHT; break;
+            default: return;
+        }
+        AccessibilityNodeInfo next = f.focusSearch(dir);
+        if (next != null) next.performAction(AccessibilityNodeInfo.ACTION_FOCUS);
+    }
+
+    /** The whole text of the field in focus (or the first field on the screen), as the phone has it now. */
+    private void text(String t) {
+        AccessibilityNodeInfo root = service.getRootInActiveWindow();
+        if (root == null) return;
+        AccessibilityNodeInfo f = root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
+        if (f == null || !f.isEditable()) {
+            f = editable(root, 0);
+            if (f == null) return;
+            f.performAction(AccessibilityNodeInfo.ACTION_FOCUS);
+        }
+        Bundle b = new Bundle();
+        b.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, t);
+        f.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, b);
+    }
+
+    private static AccessibilityNodeInfo editable(AccessibilityNodeInfo n, int depth) {
+        if (n == null || depth > 40) return null;
+        if (n.isEditable() && n.isVisibleToUser()) return n;
+        for (int i = 0; i < n.getChildCount(); i++) {
+            AccessibilityNodeInfo r = editable(n.getChild(i), depth + 1);
+            if (r != null) return r;
+        }
+        return null;
+    }
+
+    /** A white arrow with a dark edge; its tip is the top-left corner of the view, where the taps land. */
+    private static final class Arrow extends View {
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG), edge = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path shape = new Path();
+
+        Arrow(Context c) {
+            super(c);
+            fill.setColor(0xFFFFFFFF);
+            edge.setColor(0xFF10201A);
+            edge.setStyle(Paint.Style.STROKE);
+            edge.setStrokeWidth(3);
+            edge.setStrokeJoin(Paint.Join.ROUND);
+            float s = SIZE;
+            shape.moveTo(2, 2);
+            shape.lineTo(2, s * 0.82f);
+            shape.lineTo(s * 0.26f, s * 0.60f);
+            shape.lineTo(s * 0.44f, s * 0.96f);
+            shape.lineTo(s * 0.58f, s * 0.88f);
+            shape.lineTo(s * 0.41f, s * 0.54f);
+            shape.lineTo(s * 0.70f, s * 0.54f);
+            shape.close();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            c.drawPath(shape, fill);
+            c.drawPath(shape, edge);
+        }
+    }
+}
diff --git a/launcher/app/src/main/res/values-ar/bools.xml b/launcher/app/src/main/res/values-ar/bools.xml
new file mode 100644
index 0000000..ac76387
--- /dev/null
+++ b/launcher/app/src/main/res/values-ar/bools.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Noor: the app row reads right to left (first app on the right); the header keeps its layout, clock on the left. -->
+    <bool name="rtl_app_grid">true</bool>
+</resources>
