+            c.sendBroadcast(new Intent("app.noortv.TEST_ADHAN")
+                    .setComponent(new ComponentName("app.noortv.kahf", "app.noortv.Reminder"))
+                    .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES));
+        } catch (Exception ignored) {
+        }
+    }
+    /** A place from the theme is used until a city is picked from the list in the settings. */
+    private boolean themed() { return !p.contains("city") && p.contains("placeLat"); }
+
+    int method() { return p.getInt("method", themed() ? p.getInt("placeMethod", 3) : CITY_METHOD[city()]); }
+
+    double lat() { return themed() ? Double.parseDouble(p.getString("placeLat", "0")) : CITY_LL[city()][0]; }
+    double lon() { return themed() ? Double.parseDouble(p.getString("placeLon", "0")) : CITY_LL[city()][1]; }
+    String cityName() { return themed() ? p.getString("placeName", "") : CITY_NAMES[city()]; }
+
+    /**
+     * The theme's "noor_place" ({"lat":…, "lon":…, "method":…, "name":"…"}): the city written at install for a
+     * family outside the list. Kept, and sent on to the adhan app when it changes.
+     */
+    static void themePlace(Context c, org.json.JSONObject o) {
+        if (o == null || !o.has("lat") || !o.has("lon")) return;
+        try {
+            NoorPrefs prefs = new NoorPrefs(c);
+            String la = String.valueOf(o.getDouble("lat")), lo = String.valueOf(o.getDouble("lon"));
+            int m = o.optInt("method", 3);
+            String name = o.optString("name", "");
+            if (la.equals(prefs.p.getString("placeLat", null)) && lo.equals(prefs.p.getString("placeLon", null))
+                    && m == prefs.p.getInt("placeMethod", -1) && name.equals(prefs.p.getString("placeName", null))) return;
+            prefs.p.edit().putString("placeLat", la).putString("placeLon", lo).putInt("placeMethod", m)
+                    .putString("placeName", name).commit();
+            if (prefs.themed()) prefs.pushToNoorApp(c);
+        } catch (Exception ignored) {
+        }
+    }
+
+    /** Sends the adhan, reminder and city choices to the Kahf app, which schedules the adhan and the reminders. */
+    void pushToNoorApp(Context c) {
+        Intent i = new Intent("app.noortv.SETTINGS")
+                .setComponent(new ComponentName("app.noortv.kahf", "app.noortv.Reminder"))
+                .putExtra("adhan", adhan())
+                .putExtra("volume", volume())
+                .putExtra("nightVolume", nightVolume())
+                .putExtra("fajrSound", fajrSound())
+                .putExtra("remind", remind())
+                .putExtra("lat", lat())
+                .putExtra("lon", lon())
+                .putExtra("method", method())
+                .putExtra("muezzin", muezzin())
+                .putExtra("preAdhan", preAdhan())
+                .putExtra("ramadan", ramadanMode())
+                .putExtra("hijriOffset", hijriOffset())
+                // a freshly installed or force-stopped Kahf app gets it too
+                .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES);
+        try {
+            c.sendBroadcast(i);
+        } catch (Exception ignored) {
+            // Kahf app missing: nothing to tell
+        }
+    }
+}
