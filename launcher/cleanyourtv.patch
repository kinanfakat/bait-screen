+                b.setSpan(new StyleSpan(Typeface.BOLD), start, b.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+                b.setSpan(new RelativeSizeSpan(0.9f), start, b.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            } else {
+                b.setSpan(new ForegroundColorSpan(DIM), start, b.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+                b.setSpan(new RelativeSizeSpan(0.72f), start, b.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            }
+        }
+    }
