@@ -0,0 +1,56 @@
+package com.gathin.tvhome;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+
+/**
+ * Kids mode's screen time: only the time spent inside apps counts. Home leaving for an app starts the count (kept in
+ * prefs, so a restarted launcher does not lose it); Home coming back, the idle clock, the screen going off, and the
+ * control center, the timetable and the lock screen all stop it. While an app is open, an alarm brings the lock screen
+ * over it the moment the day's time is up, so it does not wait for Home.
+ */
+final class NoorKids {
+    private static final String AWAY = "kidsAway";
+
+    private NoorKids() {
+    }
+
+    /** Home is paused: if kids mode counts time, start counting and set the alarm for when the time runs out. */
+    static void leaveHome(Context c) {
+        NoorPrefs prefs = new NoorPrefs(c);
+        if (!prefs.kids()) return;
+        long now = System.currentTimeMillis();
+        prefs.p.edit().putLong(AWAY, now).apply();
+        if (prefs.kidsLimit() <= 0) return;
+        long left = prefs.kidsLimit() * 60_000L - prefs.kidsUsed();
+        try {
+            c.getSystemService(AlarmManager.class).setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,
+                    now + Math.max(1_000L, left), lockIntent(c));
+        } catch (Exception ignored) {
+        }
+    }
+
+    /** Back on Home or one of the launcher's own screens, or the screen went off: book the time and stop counting. */
+    static void stop(Context c) {
+        NoorPrefs prefs = new NoorPrefs(c);
+        SharedPreferences p = prefs.p;
+        long away = p.getLong(AWAY, 0);
+        if (away > 0) {
+            p.edit().remove(AWAY).apply();
+            if (prefs.kids()) prefs.addKidsUsed(System.currentTimeMillis() - away);
+        }
+        try {
+            c.getSystemService(AlarmManager.class).cancel(lockIntent(c));
+        } catch (Exception ignored) {
+        }
+    }
+
+    private static PendingIntent lockIntent(Context c) {
+        return PendingIntent.getActivity(c, 7, new Intent(c, NoorLockActivity.class)
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+    }
+}
