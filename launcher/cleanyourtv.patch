+    /** "الفجر 5:02   الظهر 11:41   ◆ العصر 2:39 (بعد 1:12)   المغرب 4:58   العشاء 6:17", the next one in gold. */
+    private static void appendPrayers(SpannableStringBuilder b) {
+        int[] p = prayerMinutes;
+        if (p == null) return;
+        Calendar c = Calendar.getInstance();
+        int now = c.get(Calendar.HOUR_OF_DAY) * 60 + c.get(Calendar.MINUTE);
+        int next = -1;
+        for (int i = 0; i < p.length; i++) {
+            if (p[i] > now) {
+                next = i;
+                break;
+            }
+        }
+        boolean tomorrowFajr = next < 0;
+        if (tomorrowFajr) next = 0;
+        b.append('\n');
+        for (int i = 0; i < p.length; i++) {
+            if (i > 0) b.append("  ");
+            int start = b.length();
+            b.append(PRAYERS_AR[i]).append(' ').append(clock12(p[i]));
+            if (i == next) {
+                int left = tomorrowFajr ? 24 * 60 - now + p[0] : p[i] - now;
+                b.append(" · بعد ").append(hm(left));
