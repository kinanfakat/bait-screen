+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.util.Calendar;
+
+/**
+ * Which part of the day it is for Noor, from today's prayer times:
+ *   morning  Fajr until four hours after (or Dhuhr, if sooner)    → أذكار الصباح
+ *   evening  Asr until Maghrib                                     → أذكار المساء
+ *   night    an hour after Isha until Fajr                         → أذكار النوم and sleep mode
+ */
+final class NoorTime {
+    static final String MORNING = "morning", EVENING = "evening", NIGHT = "night";
+
+    private NoorTime() {
+    }
+
+    static String window() {
+        int[] p = Noor.prayerMinutes();
+        if (p == null || p.length < 5) return "";
+        Calendar c = Calendar.getInstance();
+        int now = c.get(Calendar.HOUR_OF_DAY) * 60 + c.get(Calendar.MINUTE);
+        if (now >= p[0] && now < Math.min(p[0] + 240, p[1])) return MORNING;
+        if (now >= p[2] && now < p[3]) return EVENING;
+        if (now >= p[4] + 60 || now < p[0]) return NIGHT;
+        return "";
+    }
+
+    static String hint(String window) {
+        switch (window) {
+            case MORNING: return "☀️  وقت أذكار الصباح";
+            case EVENING: return "🌇  وقت أذكار المساء";
+            case NIGHT: return "🌙  قبل النوم: أذكار النوم وسورة الملك";
+            default: return "";
+        }
+    }
+
+    /** The card Home starts on in that window, best first. */
+    static String[] cards(String window) {
+        switch (window) {
+            case MORNING: return new String[]{"app.noortv.sabah"};
+            case EVENING: return new String[]{"app.noortv.masa"};
+            case NIGHT: return new String[]{"app.noortv.nawm", "app.noortv.mulk"};
+            default: return new String[0];
+        }
+    }
+
+    private static String key(String w) {
+        Calendar cal = Calendar.getInstance();
+        // the night window runs past midnight: count it to the day it started
+        if (NIGHT.equals(w) && cal.get(Calendar.HOUR_OF_DAY) < 12) cal.add(Calendar.DAY_OF_YEAR, -1);
+        return w + "@" + cal.get(Calendar.YEAR) + "-" + cal.get(Calendar.DAY_OF_YEAR);
+    }
+
+    /** The window Home should start on its card for (once per window and day), or null. Does not mark it. */
+    static String pendingSuggestion(Context c) {
+        NoorPrefs prefs = new NoorPrefs(c);
+        if (!prefs.timedAdhkar()) return null;
+        String w = window();
+        if (w.isEmpty() || key(w).equals(prefs.p.getString("suggested", ""))) return null;
+        return w;
+    }
+
+    /** The card was focused: not again in this window. */
+    static void markSuggested(Context c, String w) {
+        new NoorPrefs(c).p.edit().putString("suggested", key(w)).apply();
+    }
+}
