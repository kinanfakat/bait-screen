+        int today = Calendar.getInstance().get(Calendar.DAY_OF_YEAR);
+        boolean needWeather = System.currentTimeMillis() - weatherAt > 30 * 60_000L;
+        boolean needPrayer = prayerDay != today;
+        if ((!needWeather && !needPrayer) || fetching) return;
+        fetching = true;
+        new Thread(() -> {
+            boolean changed = false;
+            try {
+                if (needPrayer) changed |= loadPrayers(today);
+                if (needWeather) changed |= loadWeather();
+            } finally {
+                fetching = false;
+            }
+            Runnable r = onUpdate;
+            if (changed && r != null) r.run();
+        }, "noor").start();
+    }
+
+    private static boolean loadPrayers(int today) {
+        try {
+            Calendar c = Calendar.getInstance();
+            String date = String.format(Locale.US, "%02d-%02d-%d", c.get(Calendar.DAY_OF_MONTH),
+                    c.get(Calendar.MONTH) + 1, c.get(Calendar.YEAR));
+            JSONObject data = new JSONObject(get("https://api.aladhan.com/v1/timings/" + date + "?latitude=" + lat()
+                    + "&longitude=" + lon() + "&method=" + method()
+                    // times straight in the TV's own time zone: the site's zone data is current, the TV's may not be
+                    + "&timezonestring=" + java.net.URLEncoder.encode(java.util.TimeZone.getDefault().getID(), "UTF-8"))).getJSONObject("data");
+            JSONObject t = data.getJSONObject("timings");
+            JSONObject h = data.getJSONObject("date").getJSONObject("hijri");
+            hijriDayAladhan = Integer.parseInt(h.getString("day"));
+            hijriMonthAladhan = h.getJSONObject("month").getInt("number");
+            hijri = hijriDayAladhan + " " + MONTHS[h.getJSONObject("month").getInt("number") - 1] + " " + h.getString("year");
+            int[] m = new int[PRAYERS.length];
+            StringBuilder s = new StringBuilder();
+            for (int i = 0; i < PRAYERS.length; i++) {
+                String[] hhmm = t.getString(PRAYERS[i]).substring(0, 5).split(":");
+                m[i] = Integer.parseInt(hhmm[0]) * 60 + Integer.parseInt(hhmm[1]);
+                if (i > 0) s.append(',');
+                s.append(m[i]);
+            }
+            prayerMinutes = m;
+            prayerDay = today;
+            if (prefs != null) {
+                prefs.edit().putString("hijri", hijri).putInt("hijriDay", hijriDayAladhan).putInt("hijriMonth", hijriMonthAladhan)
+                        .putInt("prayerDay", today).putString("prayers", s.toString()).apply();
+            }
+            return true;
+        } catch (Exception ignored) {
+            // Offline: keep the saved times until the next minute tries again.
+            return false;
+        }
+    }
+
+    private static boolean loadWeather() {
+        try {
+            JSONObject root = new JSONObject(get("https://api.open-meteo.com/v1/forecast?latitude=" + lat()
+                    + "&longitude=" + lon() + "&current=temperature_2m,weather_code,is_day"
+                    + "&daily=temperature_2m_max,temperature_2m_min&forecast_days=1&timezone=auto"));
+            JSONObject cur = root.getJSONObject("current");
+            JSONObject daily = root.getJSONObject("daily");
+            long t = Math.round(cur.getDouble("temperature_2m"));
+            long hi = Math.round(daily.getJSONArray("temperature_2m_max").getDouble(0));
+            long lo = Math.round(daily.getJSONArray("temperature_2m_min").getDouble(0));
+            int code = cur.getInt("weather_code");
+            boolean day = cur.optInt("is_day", 1) == 1;
+            weather = icon(code, day) + "  " + t + "°  " + describe(code) + "     " + hi + "° / " + lo + "°";
+            weatherAt = System.currentTimeMillis();
+            if (prefs != null) prefs.edit().putString("weather", weather).putLong("weatherAt", weatherAt).apply();
+            return true;
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
+
+    /** WMO weather code to one symbol. */
+    private static String icon(int code, boolean day) {
+        if (code == 0) return day ? "☀️" : "🌙";
+        if (code <= 2) return day ? "🌤️" : "🌙";
+        if (code == 3) return "☁️";
+        if (code == 45 || code == 48) return "🌫️";
+        if (code >= 95) return "⛈️";
+        if (code >= 71 && code <= 77 || code == 85 || code == 86) return "❄️";
+        if (code >= 51) return "🌧️";
+        return "🌤️";
+    }
+
+    /** WMO weather code in Arabic. */
+    private static String describe(int code) {
+        if (code == 0) return "صافي";
+        if (code <= 2) return "غائم جزئياً";
+        if (code == 3) return "غائم";
+        if (code == 45 || code == 48) return "ضباب";
+        if (code >= 51 && code <= 57) return "رذاذ";
+        if (code >= 61 && code <= 67 || code >= 80 && code <= 82) return "ممطر";
+        if (code >= 71 && code <= 77 || code == 85 || code == 86) return "ثلج";
+        if (code >= 95) return "عاصفة رعدية";
+        return "";
+    }
+
+    private static String get(String url) throws Exception {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setConnectTimeout(8000);
+        c.setReadTimeout(8000);
+        try (InputStream in = c.getInputStream()) {
+            ByteArrayOutputStream b = new ByteArrayOutputStream();
+            byte[] buf = new byte[4096];
+            int n;
+            while ((n = in.read(buf)) > 0) b.write(buf, 0, n);
+            return b.toString("UTF-8");
+        } finally {
+            c.disconnect();
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/NoorAyah.java b/launcher/app/src/main/java/com/gathin/tvhome/NoorAyah.java
new file mode 100644
index 0000000..6f6b6c6
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/NoorAyah.java
@@ -0,0 +1,170 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * A verse in the open sky left of the mosque, picked at random from assets/ayat.txt (about 4000 short verses, text
+ * from api.alquran.cloud, written by fetch_all_ayat.py) and changed every six hours. refresh() is called with the
+ * minute tick; it only redraws when a new six-hour block has started.
+ */
+final class NoorAyah {
+    private static final long BLOCK_MS = 6 * 60 * 60 * 1000L;
+
+    private NoorAyah() {
+    }
+
+    private static Typeface naskh;
+    private static List<String> lines;
+
+    private static List<String> load(Context c) {
+        if (lines != null) return lines;
+        List<String> l = new ArrayList<>();
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(c.getAssets().open("ayat.txt"),
+                StandardCharsets.UTF_8))) {
+            String s;
+            while ((s = r.readLine()) != null) if (!s.isEmpty()) l.add(s);
+        } catch (Exception ignored) {
+        }
+        lines = l;
+        return l;
+    }
+
+    static View make(Context c) {
+        if (naskh == null) {
+            File f = new File("/system/fonts/NotoNaskhArabic-Regular.ttf");
+            naskh = f.exists() ? Typeface.createFromFile(f) : Typeface.SERIF;
+        }
+        LinearLayout box = new LinearLayout(c);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setGravity(Gravity.CENTER_HORIZONTAL);
+        // a soft 25% shade behind the verse, so it reads on any wallpaper
+        float d = c.getResources().getDisplayMetrics().density;
+        android.graphics.drawable.GradientDrawable shade = new android.graphics.drawable.GradientDrawable();
+        shade.setColor(0x40000000);
+        shade.setCornerRadius(22 * d);
+        box.setBackground(shade);
+        box.setPadding((int) (22 * d), (int) (12 * d), (int) (22 * d), (int) (12 * d));
+        box.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+
+        TextView verse = new TextView(c);
+        verse.setTypeface(naskh);
+        verse.setTextSize(TypedValue.COMPLEX_UNIT_SP, 21);
+        verse.setTextColor(0xFFF6E7C1);
+        verse.setGravity(Gravity.CENTER);
+        verse.setLineSpacing(0, 1.15f);
+        // never cut a verse: no line limit; the longest ones get a slightly smaller size in refresh()
+        verse.setTextDirection(View.TEXT_DIRECTION_RTL);
+        verse.setShadowLayer(10, 0, 2, 0xCC000000);
+        box.addView(verse);
+
+        TextView source = new TextView(c);
+        source.setTypeface(naskh);
+        source.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        source.setTextColor(0xCCE3BE6E);
+        source.setGravity(Gravity.CENTER);
+        source.setShadowLayer(8, 0, 1, Color.BLACK);
+        source.setPadding(0, 6, 0, 0);
+        box.addView(source);
+
+        int w = c.getResources().getDisplayMetrics().widthPixels, h = c.getResources().getDisplayMetrics().heightPixels;
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams((int) (w * 0.40f), FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);   // in the middle of the screen
+        lp.bottomMargin = (int) (h * 0.51f);   // in the open sky: above the weather line, under the prayer bar
+        box.setLayoutParams(lp);
+        TextView hint = new TextView(c);   // the adhkar of the hour, under the verse (setHint)
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        hint.setTextColor(0xFFFFD27A);
+        hint.setGravity(Gravity.CENTER);
+        hint.setPadding(0, 10, 0, 0);
+        hint.setVisibility(View.GONE);
+        box.addView(hint);
+
+        box.setTag(-1L);
+        refresh(box);
+        return box;
+    }
+
+    /** The highest point the box may reach (under the weather), in root pixels; -1 before the header is laid out. */
+    private static int limitTop = -1;
+
+    /**
+     * Keeps the box between the header and the cards: the verse gets smaller, down to 15sp, until the box fits
+     * under limitTop. Called when the header moves and after each new verse.
+     */
+    static void fit(View view, int top) {
+        // in the middle of the screen now, beside the clock's column and not under it: only the prayer bar is above
+        if (view.getParent() != null) limitTop = (int) (((View) view.getParent()).getHeight() * 0.20f);
+        if (!(view instanceof LinearLayout) || limitTop < 0 || view.getParent() == null) return;
+        View parent = (View) view.getParent();
+        FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) view.getLayoutParams();
+        int available = parent.getHeight() - lp.bottomMargin - limitTop;
+        if (available <= 0 || parent.getWidth() == 0) return;
+        TextView verse = (TextView) ((LinearLayout) view).getChildAt(0);
+        int widthSpec = View.MeasureSpec.makeMeasureSpec(lp.width, View.MeasureSpec.EXACTLY);
+        int heightSpec = View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED);
+        // from the verse's own size each time, so it grows back when there is room again (the weather line hidden)
+        int len = verse.getText().length();
+        float sp = len > 200 ? 17 : len > 140 ? 19 : 21;
+        verse.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        view.measure(widthSpec, heightSpec);
+        while (view.getMeasuredHeight() > available && sp > 15) {
+            sp -= 1;
+            verse.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+            view.measure(widthSpec, heightSpec);
+        }
+        // two steps under what fits: a calmer verse with room around it
+        sp = Math.max(13, sp - 2);
+        verse.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+    }
+
+    /** The gold line under the verse ("☀️ وقت أذكار الصباح"); empty hides it. */
+    static void setHint(View view, String text) {
+        if (!(view instanceof LinearLayout) || ((LinearLayout) view).getChildCount() < 3) return;
+        TextView h = (TextView) ((LinearLayout) view).getChildAt(2);
+        if (h.getText().toString().equals(text)) return;
+        h.setText(text);
+        h.setVisibility(text.isEmpty() ? View.GONE : View.VISIBLE);
+        fit(view, -1);
+    }
+
+    /** Shows the verse of the current six-hour block; does nothing while the block is the same. */
+    static void refresh(View view) {
+        if (!(view instanceof LinearLayout)) return;
+        long block = System.currentTimeMillis() / BLOCK_MS;
+        if (Long.valueOf(block).equals(view.getTag())) return;
+        List<String> all = load(view.getContext());
+        if (all.isEmpty()) {
+            view.setVisibility(View.GONE);
+            return;
+        }
+        String[] a = all.get(new Random(block * 2654435761L).nextInt(all.size())).split("\t");
+        if (a.length < 3) return;
+        LinearLayout box = (LinearLayout) view;
+        // ۞ marks a hizb quarter in the mushaf; it is not part of the verse's reading
+        String verse = a[0].replace("۞", "").trim();
+        TextView v = (TextView) box.getChildAt(0);
+        v.setTextSize(TypedValue.COMPLEX_UNIT_SP, verse.length() > 200 ? 17 : verse.length() > 140 ? 19 : 21);
+        v.setText("﴿ " + verse + " ﴾");
+        // the surah names carry small Quranic marks the TV font may not have: keep the letters and harakat only
+        ((TextView) box.getChildAt(1)).setText(new NoorPrefs(view.getContext()).localize("— " + a[1].replaceAll("[ۖ-ۭـ]", "") + " · " + a[2] + " —"));
+        view.setTag(block);
+        view.setVisibility(View.VISIBLE);
+        fit(view, -1);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/NoorHeader.java b/launcher/app/src/main/java/com/gathin/tvhome/NoorHeader.java
new file mode 100644
index 0000000..c8c3b30
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/NoorHeader.java
@@ -0,0 +1,214 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.util.Calendar;
+
+/**
+ * The Noor parts of the header, each in its own place:
+ *  - the weather on its own line under the clock,
+ *  - the five prayers as a bar in the top-right corner, the next one lit in gold,
+ *  - and beside the bar, on its left, a chip with the time left to the next prayer.
+ * update() runs with the minute tick and whenever fresh times or weather arrive.
+ */
+final class NoorHeader {
+    private static final int GOLD = 0xFFFFD27A;
+    private static final String[] NAMES = {"الفجر", "الظهر", "العصر", "المغرب", "العشاء"};
+
+    private final Context context;
+    private final NoorPrefs prefs;
+    final TextView weather;
+    /** The notices under the weather: the adhkar of the hour, the next occasion. */
+    final TextView notice;
+    /** Focus is down in the app rows: the dates, the weather and the notices step aside so more rows show. */
+    static boolean compact;
+    final LinearLayout bar;
+    private final TextView[] name = new TextView[5], time = new TextView[5];
+    private final LinearLayout[] cell = new LinearLayout[5];
+    private final TextView countdownLabel, countdownTime;
+    private final LinearLayout countdown;
+
+    NoorHeader(Context c, LinearLayout clockBlock, FrameLayout root) {
+        context = c;
+        prefs = new NoorPrefs(c);
+        float density = c.getResources().getDisplayMetrics().density;
+
+        weather = new TextView(c);
+        weather.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
+        weather.setTextColor(0xD9FFFFFF);
+        weather.setGravity(Gravity.LEFT);
+        weather.setTextDirection(View.TEXT_DIRECTION_RTL);
+        weather.setShadowLayer(6, 0, 1, 0xAA000000);
+        weather.setPadding((int) (2 * density), (int) (10 * density), 0, 0);
+        LinearLayout.LayoutParams wp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        wp.gravity = Gravity.LEFT;   // under the clock and the date, on the left
+        clockBlock.addView(weather, wp);
+
+        notice = new TextView(c);
+        notice.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        notice.setTextColor(0xFFFFD27A);
+        notice.setGravity(Gravity.LEFT);
+        notice.setTextDirection(View.TEXT_DIRECTION_RTL);
+        notice.setLineSpacing(0, 1.25f);
+        notice.setShadowLayer(6, 0, 1, 0xAA000000);
+        notice.setPadding((int) (2 * density), (int) (6 * density), 0, 0);
+        // a long notice wraps instead of running under the verse in the middle
+        notice.setMaxWidth((int) (c.getResources().getDisplayMetrics().widthPixels * 0.34f));
+        notice.setVisibility(View.GONE);
+        LinearLayout.LayoutParams np = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        np.gravity = Gravity.LEFT;
+        clockBlock.addView(notice, np);
+
+        bar = new LinearLayout(c);
+        bar.setOrientation(LinearLayout.HORIZONTAL);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
+        bar.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+
+        // the countdown chip sits on the left of the prayers
+        countdown = new LinearLayout(c);
+        countdown.setOrientation(LinearLayout.VERTICAL);
+        countdown.setGravity(Gravity.CENTER);
+        GradientDrawable chip = new GradientDrawable();
+        chip.setColor(0x33FFD27A);
+        chip.setCornerRadius(18 * density);
+        chip.setStroke((int) (1.5f * density), 0xAAFFD27A);
+        countdown.setBackground(chip);
+        countdown.setPadding((int) (16 * density), (int) (6 * density), (int) (16 * density), (int) (6 * density));
+        countdownLabel = label(13, 0xE6FFFFFF);
+        countdownTime = label(22, GOLD);
+        countdownTime.setTypeface(Typeface.DEFAULT_BOLD);
+        countdown.addView(countdownLabel);
+        countdown.addView(countdownTime);
+        LinearLayout.LayoutParams cp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        cp.rightMargin = (int) (18 * density);
+        bar.addView(countdown, cp);
+
+        // the launcher lays out left to right: Isha on the left, Fajr on the right, as Arabic reads
+        for (int k = 4; k >= 0; k--) {
+            LinearLayout box = new LinearLayout(c);
+            box.setOrientation(LinearLayout.VERTICAL);
+            box.setGravity(Gravity.CENTER);
+            box.setPadding((int) (12 * density), (int) (4 * density), (int) (12 * density), (int) (4 * density));
+            name[k] = label(14, 0xCCFFFFFF);
+            time[k] = label(19, 0xF2FFFFFF);
+            box.addView(name[k]);
+            box.addView(time[k]);
+            cell[k] = box;
+            bar.addView(box);
+        }
+        int w = c.getResources().getDisplayMetrics().widthPixels, h = c.getResources().getDisplayMetrics().heightPixels;
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.RIGHT);
+        lp.topMargin = (int) (h * 0.072f);
+        lp.rightMargin = (int) (w * 0.055f);   // top right corner
+        root.addView(bar, lp);
+        update();
+    }
+
+    /** Puts the prayer bar in the top row, just left of the Settings and Inputs buttons, centred on them. */
+    void beside(View buttons) {
+        View root = (View) bar.getParent();
+        if (root == null || buttons.getWidth() == 0) return;
+        int[] at = new int[2], rootAt = new int[2];
+        buttons.getLocationOnScreen(at);
+        root.getLocationOnScreen(rootAt);
+        float d = context.getResources().getDisplayMetrics().density;
+        FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) bar.getLayoutParams();
+        int right = root.getWidth() - (at[0] - rootAt[0]) + (int) (20 * d);
+        int barH = bar.getHeight() > 0 ? bar.getHeight() : bar.getMeasuredHeight();
+        // centred on the buttons, but never up into the wallpapers' gold band (the top 6% of the screen)
+        int top = Math.max((int) (root.getHeight() * 0.065f), at[1] - rootAt[1] + buttons.getHeight() / 2 - barH / 2);
+        if (lp.rightMargin == right && lp.topMargin == top) return;
+        lp.rightMargin = right;
+        lp.topMargin = top;
+        bar.post(() -> bar.setLayoutParams(lp));
+    }
+
+    private TextView label(float sp, int color) {
+        TextView t = new TextView(context);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setGravity(Gravity.CENTER);
+        t.setShadowLayer(6, 0, 1, 0xAA000000);
+        return t;
+    }
+
+    void update() {
+        String w = Noor.weatherText();
+        weather.setVisibility(prefs.showWeather() && !w.isEmpty() && !compact ? View.VISIBLE : View.GONE);
+        weather.setText(prefs.localize(w));
+        String hint = prefs.timedAdhkar() ? NoorTime.hint(NoorTime.window()) : "";
+        String event = prefs.showHijri() ? Noor.nextEvent() : "";
+        String n = hint.isEmpty() ? event : event.isEmpty() ? hint : hint + "\n" + event;
+        notice.setVisibility(n.isEmpty() || compact ? View.GONE : View.VISIBLE);
+        notice.setText(prefs.localize(n));
+
+        int[] p = Noor.prayerMinutes();
+        if (!prefs.showPrayers() || p == null) {
+            bar.setVisibility(View.GONE);
+            return;
+        }
+        bar.setVisibility(View.VISIBLE);
+        Calendar c = Calendar.getInstance();
+        int now = c.get(Calendar.HOUR_OF_DAY) * 60 + c.get(Calendar.MINUTE);
+        int next = -1;
+        for (int i = 0; i < p.length; i++) {
+            if (p[i] > now) {
+                next = i;
+                break;
+            }
+        }
+        boolean tomorrow = next < 0;
+        if (tomorrow) next = 0;
+        int left = tomorrow ? 24 * 60 - now + p[0] : p[next] - now;
+        float density = context.getResources().getDisplayMetrics().density;
+        for (int i = 0; i < 5; i++) {
+            boolean on = i == next;
+            name[i].setText(NAMES[i]);
+            time[i].setText(prefs.localize(Noor.clock12(p[i])));
+            name[i].setTextColor(on ? GOLD : 0xCCFFFFFF);
+            time[i].setTextColor(on ? GOLD : 0xF2FFFFFF);
+            time[i].setTypeface(on ? Typeface.DEFAULT_BOLD : Typeface.DEFAULT);
+            if (on) {
+                GradientDrawable g = new GradientDrawable();
+                g.setColor(0x26FFD27A);
+                g.setCornerRadius(14 * density);
+                cell[i].setBackground(g);
+            } else {
+                cell[i].setBackground(null);
+            }
+        }
+        String label = "باقي على " + NAMES[next];
+        // Ramadan: from Fajr to Maghrib the time to iftar; at night the time to imsak (Fajr - 10) of the coming fast:
+        // after Maghrib that is tomorrow's, so the eve of the first fast counts down and Eid's eve does not
+        int imsak = p[0] - 10;
+        if (now >= p[0] && now < p[3]) {
+            if (Noor.ramadanOn(0)) {
+                label = "باقي على الإفطار";
+                left = p[3] - now;
+            }
+        } else if (now >= p[3] ? Noor.ramadanOn(1) : Noor.ramadanOn(0)) {
+            if (now >= imsak && now < p[0]) {
+                label = "أمسكوا · باقي على الفجر";
+                left = p[0] - now;
+            } else {
+                label = "باقي على الإمساك";
+                left = now < imsak ? imsak - now : 24 * 60 - now + imsak;
+            }
+        }
+        countdownLabel.setText(label);
+        countdownTime.setText(prefs.localize(String.format(java.util.Locale.US, "%d:%02d", left / 60, left % 60)));
+    }
+}
