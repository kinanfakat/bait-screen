+++ b/launcher/app/src/main/java/com/gathin/tvhome/NoorSky.java
@@ -0,0 +1,186 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.view.View;
+
+import java.util.Random;
+import java.util.function.Supplier;
+
+/**
+ * The live layer over the Damascene wallpaper: twinkling stars and now and then a shooting star at night, slow
+ * clouds by day and dusk, and the mosque's windows breathing softly. Coordinates are those of the wallpaper art
+ * (1920x1080, damascus_wallpapers.py), scaled to the screen. About 20 frames a second while Home is visible, none
+ * while it is not.
+ */
+final class NoorSky extends View {
+    private static final long FRAME_MS = 50;
+
+    private final Supplier<String> mood;   // "morning" | "evening" | "night" | "" (another set: stars only at night)
+    /** Whether the picture on screen now is the Damascus mosque (not the Ramadan lanterns or another set). */
+    private final Supplier<Boolean> damascus;
+    private final Random rnd = new Random(7);
+    private final float[] starX = new float[140], starY = new float[140], starR = new float[140], starPhase = new float[140];
+    private final float[][] windows;
+    private final float[] windowPhase;
+    /** One warm glow per window, built once; its strength is the paint's alpha, frame by frame. */
+    private final RadialGradient[] glow;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Bitmap cloud;
+    private final float[] cloudX = {200, 900, 1500, 600}, cloudY = {170, 120, 260, 330}, cloudS = {1.2f, 0.9f, 1.1f, 0.8f};
+    private boolean running;
+    private long shootingAt = -1;
+    private float shootX, shootY;
+    private long nextShooting;
+
+    NoorSky(Context c, Supplier<Boolean> damascus, Supplier<String> mood) {
+        super(c);
+        this.damascus = damascus;
+        this.mood = mood;
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        for (int i = 0; i < starX.length; i++) {
+            starX[i] = rnd.nextFloat() * 1920;
+            starY[i] = 70 + rnd.nextFloat() * 520;
+            starR[i] = 1.2f + rnd.nextFloat() * 1.8f;
+            starPhase[i] = rnd.nextFloat() * 6.28f;
+        }
+        windows = damascusWindows();
+        windowPhase = new float[windows.length];
+        glow = new RadialGradient[windows.length];
+        for (int i = 0; i < windowPhase.length; i++) {
+            windowPhase[i] = rnd.nextFloat() * 6.28f;
+            float[] w = windows[i];
+            glow[i] = new RadialGradient((w[0] + w[2]) / 2, (w[1] + w[3]) / 2, (w[3] - w[1]) * 0.9f,
+                    Color.argb(110, 255, 205, 120), Color.TRANSPARENT, Shader.TileMode.CLAMP);
+        }
+        cloud = makeCloud();
+        nextShooting = System.currentTimeMillis() + 15_000;
+    }
+
+    /** The lit windows in damascus_wallpapers.py: hall, transept and drum. {left, top, right, bottom} */
+    private static float[][] damascusWindows() {
+        java.util.ArrayList<float[]> w = new java.util.ArrayList<>();
+        for (int x = 980 + 40; x < 1820 - 30; x += 52) {
+            if (Math.abs(x - 1400) < 110 + 10) continue;
+            w.add(new float[]{x, 704, x + 16, 764});
+        }
+        for (int x = 1400 - 110 + 26; x < 1400 + 110 - 20; x += 46) w.add(new float[]{x, 606, x + 18, 656});
+        for (int i = -2; i <= 2; i++) {
+            int x = 1400 + i * 28;
+            w.add(new float[]{x - 7, 506, x + 7, 540});
+        }
+        return w.toArray(new float[0][]);
+    }
+
+    private static Bitmap makeCloud() {
+        Bitmap b = Bitmap.createBitmap(360, 120, Bitmap.Config.ARGB_8888);
+        Canvas c = new Canvas(b);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        float[][] puffs = {{90, 70, 60}, {170, 55, 70}, {250, 72, 55}, {140, 82, 50}, {215, 85, 48}};
+        for (float[] f : puffs) {
+            p.setShader(new RadialGradient(f[0], f[1], f[2], Color.argb(70, 255, 255, 255), Color.TRANSPARENT,
+                    Shader.TileMode.CLAMP));
+            c.drawCircle(f[0], f[1], f[2], p);
+        }
+        return b;
+    }
+
+    void start() {
+        if (running) return;
+        running = true;
+        postInvalidateOnAnimation();
+    }
+
+    void stop() {
+        running = false;
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        if (!running) return;
+        float sx = getWidth() / 1920f, sy = getHeight() / 1080f;
+        long now = System.currentTimeMillis();
+        // seconds within the hour: a float of the whole clock (about 1.8e12 ms) only moves every couple of minutes,
+        // which froze the twinkling and made the clouds jump
+        float t = (android.os.SystemClock.uptimeMillis() % 3_600_000L) / 1000f;
+        String m = mood.get();
+        boolean night = "night".equals(m), evening = "evening".equals(m), morning = "morning".equals(m);
+
+        canvas.save();
+        canvas.scale(sx, sy);
+
+        // stars: night all of them, dusk a few
+        int stars = night ? starX.length : evening ? 30 : 0;
+        paint.setShader(null);
+        for (int i = 0; i < stars; i++) {
+            float a = 0.45f + 0.55f * (0.5f + 0.5f * (float) Math.sin(t * (0.6f + (i % 5) * 0.25f) + starPhase[i]));
+            paint.setColor(Color.argb((int) (a * 230), 255, 250, 235));
+            canvas.drawCircle(starX[i], starY[i], starR[i], paint);
+        }
+
+        // a shooting star every 25 to 60 seconds at night
+        if (night) {
+            if (shootingAt < 0 && now > nextShooting) {
+                shootingAt = now;
+                shootX = 300 + rnd.nextFloat() * 900;
+                shootY = 90 + rnd.nextFloat() * 160;
+            }
+            if (shootingAt >= 0) {
+                float k = (now - shootingAt) / 1100f;
+                if (k > 1) {
+                    shootingAt = -1;
+                    nextShooting = now + 25_000 + rnd.nextInt(35_000);
+                } else {
+                    float x = shootX + k * 420, y = shootY + k * 170;
+                    paint.setStrokeWidth(2.4f);
+                    paint.setShader(new LinearGradient(x - 160, y - 65, x, y, Color.TRANSPARENT,
+                            Color.argb((int) (255 * (1 - k)), 255, 248, 225), Shader.TileMode.CLAMP));
+                    canvas.drawLine(x - 160, y - 65, x, y, paint);
+                    paint.setShader(null);
+                }
+            }
+        }
+
+        // clouds drifting right to left, very slowly
+        if (morning || evening) {
+            paint.setColorFilter(null);
+            paint.setAlpha(morning ? 255 : 150);
+            for (int i = 0; i < cloudX.length; i++) {
+                float x = cloudX[i] - (t * (6 + i * 2)) % 2400;
+                if (x < -400) x += 2400;
+                canvas.save();
+                canvas.translate(x, cloudY[i]);
+                canvas.scale(cloudS[i] * 1.6f, cloudS[i] * 1.6f);
+                canvas.drawBitmap(cloud, 0, 0, paint);
+                canvas.restore();
+            }
+            paint.setAlpha(255);
+        }
+
+        // the mosque's windows breathe: a warm glow that rises and falls, each at its own pace
+        boolean lit = (night || evening) && damascus.get();
+        if (lit) {
+            for (int i = 0; i < windows.length; i++) {
+                float[] w = windows[i];
+                float a = 0.5f + 0.5f * (float) Math.sin(t * 0.7f + windowPhase[i]);
+                float cx = (w[0] + w[2]) / 2, cy = (w[1] + w[3]) / 2, r = (w[3] - w[1]) * 0.9f;
+                paint.setShader(glow[i]);
+                paint.setAlpha((int) (255 * (0.36f + 0.64f * a)));
+                canvas.drawCircle(cx, cy, r, paint);
+            }
+            paint.setShader(null);
+            paint.setAlpha(255);
+        }
+
+        canvas.restore();
+        // nothing moves (daytime on a set without clouds): look again in two seconds instead of 20 frames a second
+        boolean moving = stars > 0 || morning || evening || lit || shootingAt >= 0;
+        if (running) postInvalidateDelayed(moving ? FRAME_MS : 2_000);
+    }
+}
