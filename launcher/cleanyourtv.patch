+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+
+/** Kids mode: which apps stay on Home. OK ticks or unticks an app; the choice is saved at once. */
+public class NoorKidsAppsActivity extends Activity {
+    private static final int GOLD = 0xFFE3BE6E;
+
+    @Override
+    protected void onCreate(Bundle b) {
+        super.onCreate(b);
+        NoorPrefs prefs = new NoorPrefs(this);
+        float d = getResources().getDisplayMetrics().density;
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.setBackground(new GradientDrawable(GradientDrawable.Orientation.TL_BR,
+                new int[]{0xF0101830, 0xF0180F28, 0xF0060A16}));
+        LinearLayout list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        int side = (int) (getResources().getDisplayMetrics().widthPixels * 0.25f);
+        list.setPadding(side, (int) (30 * d), side, (int) (40 * d));
+        scroll.addView(list);
+
+        TextView title = new TextView(this);
+        title.setText("✦  تطبيقات الأطفال  ✦");
+        title.setTextColor(GOLD);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 28);
+        title.setGravity(Gravity.CENTER);
+        list.addView(title);
+        TextView hint = new TextView(this);
+        hint.setText("اللي عليه ✓ يبقى بالشاشة لما يكون وضع الأطفال شغال · OK للتغيير · رجوع للحفظ والخروج");
+        hint.setTextColor(0x99F4EEDF);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        hint.setGravity(Gravity.CENTER);
+        hint.setPadding(0, (int) (6 * d), 0, (int) (16 * d));
+        list.addView(hint);
+
+        PackageManager pm = getPackageManager();
+        List<ResolveInfo> apps = new ArrayList<>(pm.queryIntentActivities(
+                new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LEANBACK_LAUNCHER), 0));
+        Collections.sort(apps, (x, y) -> String.valueOf(x.loadLabel(pm)).compareTo(String.valueOf(y.loadLabel(pm))));
+        Set<String> chosen = prefs.kidsApps();
+        View first = null;
+        for (ResolveInfo ri : apps) {
+            String pkg = ri.activityInfo.packageName;
+            if (pkg.equals(getPackageName()) || pkg.equals(NoorPrefs.CONTROL)) continue;
+            TextView row = new TextView(this);
+            row.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+            row.setTextColor(0xFFF4EEDF);
+            row.setGravity(Gravity.RIGHT | Gravity.CENTER_VERTICAL);
+            row.setPadding((int) (20 * d), (int) (12 * d), (int) (20 * d), (int) (12 * d));
+            row.setFocusable(true);
+            String label = String.valueOf(ri.loadLabel(pm));
+            Runnable paint = () -> {
+                boolean on = chosen.contains(pkg);
+                row.setText((on ? "✓   " : "     ") + label);
+                row.setTextColor(on ? GOLD : 0xFFF4EEDF);
+            };
+            paint.run();
+            row.setOnFocusChangeListener((v, f) -> {
+                GradientDrawable g = new GradientDrawable();
+                g.setCornerRadius(14 * d);
+                g.setColor(f ? 0x40E3BE6E : 0x14FFFFFF);
+                g.setStroke((int) ((f ? 2 : 1) * d), f ? GOLD : 0x22FFFFFF);
+                v.setBackground(g);
+            });
+            row.getOnFocusChangeListener().onFocusChange(row, false);
+            row.setOnClickListener(v -> {
+                if (!chosen.remove(pkg)) chosen.add(pkg);
+                prefs.p.edit().putStringSet("kidsApps", new java.util.HashSet<>(chosen))
+                        .putInt("rev", (int) (System.currentTimeMillis() / 1000)).apply();
+                paint.run();
+            });
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT);
+            lp.topMargin = (int) (6 * d);
+            list.addView(row, lp);
+            if (first == null) first = row;
+        }
+        setContentView(scroll);
+        if (first != null) first.requestFocus();
+    }
+}
