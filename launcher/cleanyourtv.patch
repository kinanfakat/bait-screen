+        action("التطبيقات المسموحة للأطفال  ←", () -> startActivity(new Intent(this, NoorKidsAppsActivity.class)));
+        choice("وقت الشاشة باليوم", NoorPrefs.KIDS_LIMIT_NAMES,
+                () -> Math.max(0, indexOf(NoorPrefs.KIDS_LIMITS, prefs.kidsLimit())),
+                i -> p.edit().putInt("kidsLimit", NoorPrefs.KIDS_LIMITS[i]).apply());
+        action("تغيير الرقم السري (الحالي يبدأ 1234)  ←", () ->
+                NoorPin.ask(this, "اكتب الرقم السري الحالي", prefs.kidsPin(), (ok, pin) -> {
+                    if (!ok) return;
+                    NoorPin.ask(this, "اكتب الرقم السري الجديد", null, (ok2, pin2) -> {
+                        if (ok2) p.edit().putString("kidsPin", pin2).apply();
+                    });
+                }));
+
+        section("الترتيب");
+        action("عدد التطبيقات بالصف، شفافية الشريط، الحركات ←", () ->
+                startActivity(new Intent(this, LauncherSettingsActivity.class)));
+        action("ترتيب التطبيقات: ارجع للشاشة واضغط مطوّلاً على أي تطبيق ← نقل", null);
+        action("رجّع كل خيارات نور للأصل", () -> {
+            p.edit().clear().apply();
+            bump();
+            prefs.pushToNoorApp(this);
+            refreshValues();
+        });
+    }
+
+    // ---- rows ------------------------------------------------------------------------------------------------
+
+    private interface IntGetter {
+        int get();
+    }
+
+    private interface IntSetter {
+        void set(int i);
+    }
+
+    private void choice(String name, String[] values, IntGetter get, IntSetter set) {
+        addRow(name, new Row() {
+            public String value() {
+                int i = get.get();
+                return values[Math.min(Math.max(i, 0), values.length - 1)];
+            }
+
+            public void step(int dir) {
+                int i = (get.get() + dir + values.length) % values.length;
+                set.set(i);
+                bump();
+            }
+        });
+    }
+
+    private void toggle(String name, String key, boolean def) {
+        addRow(name, new Row() {
+            public String value() {
+                return prefs.p.getBoolean(key, def) ? "ظاهر ✓" : "مخفي";
+            }
+
+            public void step(int dir) {
+                prefs.p.edit().putBoolean(key, !prefs.p.getBoolean(key, def)).apply();
+                bump();
+                if ("preAdhan".equals(key)) prefs.pushToNoorApp(NoorSettingsActivity.this);
+            }
+        });
+    }
+
+    private TextView action(String name, Runnable run) {
+        TextView t = text(name, 18, run == null ? DIM_TEXT : TEXT, false);
+        t.setGravity(Gravity.RIGHT);
+        t.setPadding(dp(20), dp(14), dp(20), dp(14));
+        if (run != null) {
+            t.setFocusable(true);
+            t.setBackground(rowBackground(false));
+            t.setOnFocusChangeListener((v, f) -> v.setBackground(rowBackground(f)));
+            t.setOnClickListener(v -> run.run());
+        }
+        list.addView(t, rowParams());
+        return t;
+    }
+
+    private void addRow(String name, Row row) {
+        LinearLayout r = new LinearLayout(this);
+        r.setOrientation(LinearLayout.HORIZONTAL);
+        r.setGravity(Gravity.CENTER_VERTICAL);
+        r.setPadding(dp(20), dp(12), dp(20), dp(12));
+        r.setFocusable(true);
+        r.setBackground(rowBackground(false));
+
+        // The launcher lays out left to right (no supportsRtl): the value goes on the left, the name on the right.
+        TextView value = text("", 18, GOLD, true);
+        GradientDrawable pill = new GradientDrawable();
+        pill.setCornerRadius(dp(12));
+        pill.setColor(0x22E3BE6E);
+        value.setBackground(pill);
+        value.setPadding(dp(14), dp(4), dp(14), dp(4));
+        r.addView(value);
+        TextView label = text(name, 18, TEXT, false);
+        label.setGravity(Gravity.RIGHT | Gravity.CENTER_VERTICAL);
+        r.addView(label, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        r.setTag(new Object[]{row, value});
+        value.setText(row.value());
+
+        r.setOnFocusChangeListener((v, f) -> v.setBackground(rowBackground(f)));
+        r.setOnClickListener(v -> {
+            row.step(1);
+            value.setText(row.value());
+        });
+        r.setOnKeyListener((v, code, e) -> {
+            if (e.getAction() != KeyEvent.ACTION_DOWN) return false;
+            // Right takes the next value, Left the previous one (as the wird turns pages)
+            if (code == KeyEvent.KEYCODE_DPAD_LEFT || code == KeyEvent.KEYCODE_DPAD_RIGHT) {
+                row.step(code == KeyEvent.KEYCODE_DPAD_RIGHT ? 1 : -1);
+                value.setText(row.value());
+                return true;
+            }
+            return false;
+        });
+        list.addView(r, rowParams());
+    }
+
+    private void refreshValues() {
+        for (int i = 0; i < list.getChildCount(); i++) {
+            Object tag = list.getChildAt(i).getTag();
+            if (tag instanceof Object[]) {
+                Object[] t = (Object[]) tag;
+                ((TextView) t[1]).setText(((Row) t[0]).value());
+            }
+        }
+    }
+
+    private void section(String name) {
+        TextView t = text("—  " + name + "  —", 15, GOLD, true);
+        t.setGravity(Gravity.RIGHT);
+        t.setPadding(dp(8), dp(22), dp(8), dp(6));
+        list.addView(t);
+    }
+
+    // ---- helpers -----------------------------------------------------------------------------------------------
+
+    /** Tells Home something changed, so it rebuilds itself when it comes back. */
+    private void bump() {
+        // a fresh value every time, so even "reset everything" (which clears the old one) is seen as a change
+        prefs.p.edit().putInt("rev", (int) (System.currentTimeMillis() / 1000)).apply();
+    }
+
+    private GradientDrawable rowBackground(boolean focused) {
+        GradientDrawable d = new GradientDrawable();
+        d.setCornerRadius(dp(14));
+        d.setColor(focused ? 0x40E3BE6E : 0x14FFFFFF);
+        d.setStroke(dp(focused ? 2 : 1), focused ? GOLD : 0x22FFFFFF);
+        return d;
+    }
+
+    private LinearLayout.LayoutParams rowParams() {
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = dp(6);
+        return lp;
+    }
+
+    private TextView text(String s, float sp, int color, boolean bold) {
+        TextView t = new TextView(this);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setTextDirection(View.TEXT_DIRECTION_RTL);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setShadowLayer(4, 0, 1, Color.BLACK);
+        return t;
+    }
+
+    private int dp(int v) {
+        return (int) (v * density + 0.5f);
+    }
+
+    private static int indexOf(String[] a, String v, int def) {
+        for (int i = 0; i < a.length; i++) if (a[i].equals(v)) return i;
+        return def;
+    }
+
+    private static int indexOf(int[] a, int v) {
+        for (int i = 0; i < a.length; i++) if (a[i] == v) return i;
+        return -1;
+    }
+}
