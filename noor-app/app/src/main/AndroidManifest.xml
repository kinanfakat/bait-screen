<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the phone page as keyboard and mouse: the launcher's PhonePad hears only apps with this -->
    <uses-permission android:name="com.gathin.tvhome.permission.PAD" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- MemGuard: closing apps left open in the background when the memory runs out -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- an app sent from the phone page: Android's installer asks on the TV, and the owner allows this app once -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «مدير التطبيقات»: every app on the TV, and removing one (Android asks on the TV first) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- HomeStatus: the router of the network in use -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Granted with appops over adb: a short screen timeout puts the TV back to standby after an adhan that woke it. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Granted with appops over adb, to tell the home screen from a film before playing the adhan. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.gathin.tvhome" />
        <!-- a link from the phone: YouTube's apps and the browsers it may open in -->
        <package android:name="org.smarttube.beta" />
        <package android:name="org.smarttube.stable" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.tcl.browser" />
        <package android:name="com.opera.browser" />
        <package android:name="org.mozilla.tv.firefox" />
        <package android:name="com.android.chrome" />
        <package android:name="org.droidtv.nettvbrowser" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Family quiz and Quran memorizer: they live with the phone page server in the Kahf app; their cards
             (app.noortv.quiz, app.noortv.hifz) open them. -->
        <activity android:name=".QuizActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".HifzActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- The family games: صح ولا غلط and بدون كلام play from the phones too; the memory game with the remote. -->
        <activity android:name=".TrueFalseActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".CharadesActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".MemoryActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".WhoActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- ألعاب العيلة: one card for all the games; the remote-only games for two teams and a host. -->
        <activity android:name=".GamesActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".TeamsActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- حديث اليوم: a hadith a day with its explanation, from hadeethenc.com -->
        <activity android:name=".HadithActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- «ديني» and «البيت»: one Home card for a family of cards -->
        <activity android:name=".FolderActivity$Deen" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".FolderActivity$House" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- حالة البيت: the internet, the power and their last cuts -->
        <activity android:name=".StatusActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- الطاقة الشمسية: the Solis system live, from SolisCloud -->
        <activity android:name=".EnergyActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- the installer's answer for an app sent from the phone page -->
        <receiver android:name=".ApkInstall" android:exported="false" />

        <!-- مدير التطبيقات: every app on the TV -->
        <activity android:name=".AppsActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- المباريات: yesterday's, today's and tomorrow's football, from FotMob -->
        <activity android:name=".MatchesActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The adhan that switched the TV on from standby, and the countdown back to standby after it. -->
        <activity android:name=".AdhanScreen" android:exported="false" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="app.noortv.adhan"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- A notice that switches the TV on from standby (ten minutes before the adhan). -->
        <activity android:name=".WakeScreen" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleTask"
            android:taskAffinity="app.noortv.wake" android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- The daily wird: the mushaf page by page. -->
        <activity android:name=".WirdActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The Quran radio's own player screen: Back closes it and the sound stops with it. -->
        <activity android:name=".RadioActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service android:name=".MessageServer" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Shows phone messages on the TV" />
        </service>

        <receiver android:name=".Reminder" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- the clock or the time zone corrected: the adhan alarms are set again for the new time -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".Adhan" android:exported="true" />

    </application>
</manifest>
